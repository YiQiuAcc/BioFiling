generator client {
  provider = "prisma-client"
  output   = "../src/server/generated"
}

datasource db {
  provider = "sqlite"
}

model Forms {
  id Int @id @default(autoincrement())

  projectName String  @map("project_name") // 项目名称
  department  String? // 所在部门
  leaderName  String? @map("leader_name") // 负责人姓名

  status       String @default("SUBMITTED")
  auditComment String?      @map("audit_comment")

  content       Json
  // 提交人信息
  submitterId   String   @map("submitter_id") // NetID
  submitterName String   @map("submitter_name") // 姓名
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 按提交人、状态或时间查询
  @@index([submitterId])
  @@index([status])
  @@index([createdAt])
  @@map("forms")
}
