{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "semi": false,
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "auto",
  "trailingComma": "all",
  "tabWidth": 2,
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "importOrder": [
    "^vue$",
    "^vue-router$",
    "^pinia$",
    "^tdesign-vue-next$",
    "^@vee-validate/(.*)$",
    "^axios$",
    "^zod$",
    "<THIRD_PARTY_MODULES>",
    "^@/schemas/(.*)$",
    "^@/utils/(.*)$",
    "^@/api/(.*)$",
    "^@/stores/(.*)$",
    "^@/router/(.*)$",
    "^@/components/(.*)$",
    "^@/views/(.*)$",
    "^@/types/(.*)$",
    "^@/assets/(.*)$",
    "^@/styles/(.*)$",
    "^@/(.*)$",
    "^[.][.]/(.*)$",
    "^[.]/(.*)$",
    "[.](css|less|scss|sass|stylus)$"
  ]
}
