{
  "name": "biosafety-filing",
  "private": "true",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"Vite,Server\" -c \"green,blue\" \"vite\" \"nodemon --config nodemon.json\"",
    "build": "vue-tsc -b && vite build && tsup src/server/server.ts --format esm --out-dir dist-server --clean --minify --tsconfig tsconfig.server.json",
    "postbuild": "node scripts/clean-empty.js",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node --env-file=.env.production dist-server/server.js",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src",
    "db:generate": "cross-env NODE_ENV=development env-cmd -f .env.development prisma generate",
    "db:migrate": "cross-env NODE_ENV=development env-cmd -f .env.development prisma migrate dev",
    "db:studio": "env-cmd -f .env.development prisma studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/archiver": "^7.0.0",
    "@types/xml2js": "^0.4.14",
    "@vee-validate/zod": "^4.15.1",
    "archiver": "^7.0.1",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "docx-templates": "^4.15.0",
    "env-cmd": "^11.0.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "pinia": "^3.0.4",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.1",
    "uuidv7": "^1.2.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "less": "^4.6.4",
    "lodash-es": "^4.18.1",
    "nodemon": "^3.1.14",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "sass": "^1.101.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.5",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.4"
  }
}
